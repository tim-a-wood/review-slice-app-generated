{
  "name": "review-slice",
  "version": "1.0.0",
  "description": "Local source-linked technical review application.",
  "author": "Tim Wood",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vite build --mode module-tests && node --test .test-out/artifact-processing.test.js .test-out/evidence-export.test.js .test-out/experience-contract.test.js .test-out/experience-view-model.test.js .test-out/findings.test.js .test-out/review-workflow.test.js",
    "build:renderer": "vite build",
    "build:electron": "vite build --mode electron-main && vite build --mode electron-preload",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win zip --x64 --publish never",
    "dist:win": "npm run package:win",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "build": {
    "appId": "com.reviewslice.desktop",
    "productName": "Review Slice",
    "artifactName": "Review-Slice-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "signExecutable": false
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "mammoth": "1.12.0",
    "pdfjs-dist": "5.4.296"
  }
}
