{
  "name": "review-slice",
  "version": "1.0.0",
  "description": "Local source-linked technical review application.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node .test-out/test/integration.js",
    "build": "npm run typecheck && vite build && vite build --ssr electron/main.ts --outDir dist-electron && vite build --ssr electron/preload.ts --outDir dist-electron",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "build": {
    "appId": "com.reviewslice.desktop",
    "productName": "Review Slice",
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
